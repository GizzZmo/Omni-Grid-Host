{
  "name": "omni-grid-host",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "daemon": "node server/omnigrid-daemon.mjs",
    "dev:full": "concurrently \"npm run daemon\" \"npm run dev\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "desktop": "npm run tauri:dev",
    "plugin:bundle": "tsx scripts/omni-plugin-cli.ts",
    "plugin:sync-all": "tsx scripts/omni-plugin-cli.ts --batch-profile"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0",
    "react-grid-layout": "^1.5.0",
    "lucide-react": "^0.460.0",
    "ws": "^8.18.0",
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "concurrently": "^9.0.0"
  }
}
